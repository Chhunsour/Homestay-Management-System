# ---------------------------------------------------------------------------
# Copy to apps/web/.env.local and apps/mobile/.env respectively.
# Never commit real values. The anon key is public by design; the service role
# key must NEVER appear in either app.
#
# The local ports below match supabase/config.toml, which is deliberately
# offset from Supabase's defaults so this stack can run beside other projects.
# ---------------------------------------------------------------------------

# --- Web (apps/web/.env.local) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Absolute origin used to build OAuth / email redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma separated. Controls which buttons render AND which flows are wired.
# Allowed: password,phone,google,apple
NEXT_PUBLIC_AUTH_PROVIDERS=password,phone,google,apple

# --- Mobile (apps/mobile/.env) ---------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must match "scheme" in apps/mobile/app.config.ts and the Supabase redirect allow-list.
EXPO_PUBLIC_APP_SCHEME=homestay
# Password resets finish in the web app, so the mobile app needs its origin.
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_AUTH_PROVIDERS=password,phone,google,apple

# --- Local database (used by npm run db:test) -------------------------------
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# --- Edge Function secret (supabase/functions/.env, never apps/*) -----------
# Server-side only — the ocr-payment-proof function reads this from its own
# process environment. It must never be prefixed NEXT_PUBLIC_/EXPO_PUBLIC_ or
# appear in either app's .env file. See docs/PHASE_6A_OCR.md.
ANTHROPIC_API_KEY=sk-ant-...
