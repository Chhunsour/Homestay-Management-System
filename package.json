{
  "name": "homestay-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @homestay/web",
    "dev:web": "npm run dev -w @homestay/web",
    "dev:mobile": "npm run dev -w @homestay/mobile",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:smoke": "node supabase/tests/smoke.mjs",
    "db:test": "supabase db reset && npm run db:test:sql",
    "db:test:sql": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_isolation.sql -f supabase/tests/rls_properties.sql -f supabase/tests/rls_customers.sql -f supabase/tests/rls_bookings.sql -f supabase/tests/rls_payments.sql -f supabase/tests/rls_ocr_booking_payment.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
